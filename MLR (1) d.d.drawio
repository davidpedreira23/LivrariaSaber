        <mxCell id="cENIT8A100VGqz-3YxXS-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Cliente (codigo_cliente, nome, cpf, telefone, email)&lt;div&gt;&lt;br&gt;&lt;div&gt;Funcionario (codigo_funcionario, nome, cargo)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Gerente (codigo_gerente, nome, cargo)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Compra (codigo_venda, data, valor_total, codigo_cliente*, codigo_funcionario* ,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;codigo_gerente*&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;• codigo_cliente REFERENCIA Cliente(codigo_cliente)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;• codigo_funcionario REFERENCIA Funcionario(codigo_funcionario)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;•&amp;nbsp;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;codigo_gerente REFERENCIA&amp;nbsp; Gerente(codigo_gerente)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;Emprestimo (codigo_emprestimo, data_devolucao, valor_total, codigo_cliente*, codigo_funcionario*&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;codigo_gerente*&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;• codigo_cliente REFERENCIA Cliente(codigo_cliente)&lt;/div&gt;&lt;div&gt;• codigo_funcionario REFERENCIA Funcionario(codigo_funcionario)&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;• &lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;codigo_gerente REFERENCIA&amp;nbsp; Gerente(codigo_gerente)&lt;/span&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;Pagamento (codigo_pagamento, forma_pagamento, valor_pago, codigo_venda*, codigo_emprestimo*)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;• codigo_venda REFERENCIA Compra(codigo_venda)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;• codigo_emprestimo REFERENCIA Emprestimo(codigo_emprestimo)&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;Item_Venda (codigo_item, codigo_venda*, codigo_livro*, quantidade, valor_unitario, desconto)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;• codigo_venda REFERENCIA Compra(codigo_venda)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;• codigo_livro REFERENCIA Livro(codigo_livro)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;Item_Emprestimo (codigo_item_emprestimo, codigo_emprestimo*, codigo_livro*, quantidade, valor_unitario, desconto)&lt;/div&gt;&lt;div&gt;• codigo_emprestimo REFERENCIA Emprestimo(codigo_emprestimo)&lt;/div&gt;&lt;div&gt;• codigo_livro REFERENCIA Livro(co